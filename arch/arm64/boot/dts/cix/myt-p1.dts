		lpu_raxi_boutstdcapb = <32>;
		lpu_raxi_ben = <0>;
		lpu_raxi_burstlen = <16>;
		lpu_raxi_arqos = <15>;
		lpu_raxi_ord = <0>;
		lpu_waxi_outstdcapb = <16>;
		lpu_waxi_burstlen = <16>;
		lpu_waxi_awqos = <15>;
		lpu_waxi_ord = <0>;
		lpu_l0_arcache = <3>;
		lpu_l1_arcache = <3>;
		lpu_l2_arcache = <3>;
		lpu_l3_arcache = <3>;
		lpu_lw_arcache = <3>;
		port {
			dpu0_pipe0_out: endpoint {
				remote-endpoint = <&dp0_0_in>;
			};
		};
	};

	pipeline@1 {
		port {
			dpu0_pipe1_out: endpoint {
