&usbss_0 {
	status = "okay";
	dr_mode = "otg";
	usb-role-switch;
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		cdnsp_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbc_phy0 {
	orientation-switch;
	svid = <0xff01>;
	status = "okay";
	default_conf = /bits/ 8 <0x03>;
	mode-switch;
	phy-status = "usb"; //add for gop,modified at startup

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdpphy0_lane_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_phy_sw>;
		};
	};
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_i2c0>;
	clock-frequency = <100000>;

	husb311: tcpc@4e {
		compatible = "hynetek,husb311";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_husb311_int>;
		reg = <0x4e>;
		interrupt-parent = <&s5_gpio0>;
		interrupts = <12 IRQ_TYPE_LEVEL_LOW>;
		vbus-supply = <&reg_usbc0_vbus>;

		port {
			usbc0_role_sw: endpoint {
				remote-endpoint = <&cdnsp_0_role_switch>;
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
				     PDO_VAR(5000, 20000, 3000)>;
			op-sink-microwatt = <15000000>;
			self-powered;
			displayport = <&dp0>;

			altmodes {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				altmode@0 {
					reg = <0x00>;
					svid = <0xff01>;
					vdo = <0xffffffff>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					usbc0_phy_sw: endpoint {
						remote-endpoint = <&usbdpphy0_lane_switch>;
					};
				};

				port@2 {
					reg = <2>;
					typec_dp_aux: endpoint {
						remote-endpoint = <&dp_aux_data>;
					};
				};
			};
		};
	};
};

