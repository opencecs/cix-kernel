/* FU1 TMP75 is on PM_I2C3 (CSU PM domain), address 0x48.
 * It is not connected to the FCH i2c3 pads. PM firmware/SCMI owns this path.
 * See /Y4/repo/mcu/doc/THERMAL.md. */

/*
 * Y4 新板: 槽位热插拔由 IX8024 交换芯片自身处理(板级不再有 4 片 TCA9555),
 * 故 TCA9555 扩展器节点与其用户(槽位按键 gpio_keys_slot / 槽位运行灯
 * gpio_leds_slot)全部移除。
 * 保留: GPIO019/SFI_GPIO4 的中断 pinctrl 组(pinctrl_tca9555_int) —— 该引脚
 * 同时接到 MCU 的 PA0, 不能删。
 */

/* Physical FAN1 uses FANOUT0_1V8 and FANTACH0_1V8. The connector
 * references on the schematic are transposed. UART1 and the GPT node
 * covering Timer 3 are disabled on Y4.
 */
&pwm3 {
	compatible = "myt,y4-fan1-pwm", "cix,sky1-pwm";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_fan0>;
	status = "okay";
};

&pwm5 {
	compatible = "myt,y4-fan2-pwm", "cix,sky1-pwm";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_fan2>;
	status = "disabled";
};

/ {
	cix_fan: pwm-fan {
		compatible = "myt,y4-soc-fan1", "pwm-fan";
		pwms = <&pwm3 0 40000>;	/* 25 kHz */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fan1_tach>;
		tach-gpios = <&fch_gpio1 25 GPIO_ACTIVE_HIGH>;
		myt,thermal-zones = <&thermal_zone_cpu &thermal_zone_cpu_m1
				     &thermal_zone_cpu_b0 &thermal_zone_cpu_b1>;
		status = "okay";
	};

	cix_fan2: pwm-fan-aux {
		compatible = "myt,y4-soc-fan2", "pwm-fan";
		pwms = <&pwm5 0 40000>;	/* 25 kHz */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fan2_tach>;
		tach-gpios = <&fch_gpio1 23 GPIO_ACTIVE_HIGH>;
		myt,thermal-zones = <&thermal_zone_cpu &thermal_zone_cpu_m1
				     &thermal_zone_cpu_b0 &thermal_zone_cpu_b1>;
		status = "disabled";
	};
};

/* The 60 C maps only switched on the original power allocator. Temperature
 * feedback starts CPU cooling at the original 85 C control trip instead.
 * Keep the 98 C critical trips and the 85 C cooling maps unchanged.
 */
&thermal_zone_cpu { cooling-maps { /delete-node/ map0; }; };
&thermal_zone_cpu_m1 { cooling-maps { /delete-node/ map0; }; };
&thermal_zone_cpu_b0 { cooling-maps { /delete-node/ map0; }; };
&thermal_zone_cpu_b1 { cooling-maps { /delete-node/ map0; }; };

/* 0011: the SCP/SCMI firmware does not answer sensor reads for these zones;
 * each poll holds the shared SCMI transport until timeout and stalls the
 * console. Board temperature is collected from the IX8024 over I2C instead.
 */
&thermal_zones {
	tz-vpu { polling-delay-passive = <0>; polling-delay = <0>; };
	tz-gpu0 { polling-delay-passive = <0>; polling-delay = <0>; };
