&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_i2c0>;
	
	typec_controller_0: husb311@4e {
		compatible = "hynetek,husb311"; 
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl0_husb311_int>;
		reg = <0x4E>;              
		interrupt-parent = <&s5_gpio0>; 
		interrupts = <12 IRQ_TYPE_LEVEL_LOW>; 
		vbus-supply = <&vbus_typec_regulator_0>;
		
		usb_con_0: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <2500000>;
			/* U68 MT9700: RSET=4.7k, nominal limit ~1.45A. */
			/* Advertise only 5V/900mA; never request higher sink voltage. */
			source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM)>;
			/* Self-powered board: conservative 5V-only sink contract. */
			sink-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_USB_COMM)>;
                	
                	self-powered;
			displayport = <&dp0>;
			
			altmodes {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				altmode@0 {
					reg = <0x00>;
					svid = <0xff01>;
					/* DP source, HBR3, receptacle; pin assignments C/D/E. */
					vdo = <0x00001c46>;
				};
			};

			ports {
                		#address-cells = <1>;
                		#size-cells = <0>;

                		port@0 {
                    			reg = <0>;
                    			usbc0_phy_sw: endpoint {
							remote-endpoint = <&usbdpphy0_lane_switch>;
					};
            			};
            			port@1 {
					reg = <1>;
					typec_dp_aux_0: endpoint {
						remote-endpoint = <&dp_aux_data_0>;
					};
				};
			};
			
		};
         
         		ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					usbc0_role_sw: endpoint@0 {
						remote-endpoint = <&cdnsp_0_role_switch>;
					};
				};
			};
        
        };
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_i2c1_sfi>;
	clock-frequency = <100000>;
	
	typec_controller_1: husb311@4e {
        status = "disabled"; /* Y4 has only J8/USBC0; no second Type-C circuit. */
		compatible = "hynetek,husb311";
		reg = <0x4E>;              
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl1_husb311_int>;
		interrupt-parent = <&s5_gpio0>; 
		interrupts = <9 IRQ_TYPE_LEVEL_LOW>; 
		vbus-supply = <&vbus_typec_regulator_1>;
		
         	usb_con_1: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <15000000>;
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
                		
                	self-powered;
			displayport = <&dp1>;
			
			altmodes {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				altmode@0 {
					reg = <0x00>;
					svid = <0xff01>;
					vdo = <0xffffffff>;
				};
			};
                		
			ports {
                		#address-cells = <1>;
                		#size-cells = <0>;

                		port@0 {
                    			reg = <0>;
                    			usbc1_phy_sw: endpoint {
							/* No second Type-C PHY endpoint on Y4. */
					};
            			};
            			
            			port@1 {
					reg = <1>;
					typec_dp_aux_1: endpoint {
						remote-endpoint = <&dp_aux_data_1>;
					};
				};
			};
			
		};
         
         		ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					usbc1_role_sw: endpoint@0 {
						remote-endpoint = <&cdnsp_1_role_switch>;
					};
				};
			};
        
        };
};

&i2c2 {
	status = "okay";
