&pcie_x8_rc {
	linux,pci-domain = <0>;
	/* Fixed packet size for the complete IX8024 / M50 / Optane fabric. */
	max-payload = <256>;
	sky1,fixed-mps = <256>;
	/* Late M50 enumeration needs three 1 MiB non-prefetchable BARs. */
	myt,downstream-hotplug-mmio-min = <0x400000>;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x8_rc>;
	reset-gpios = <&s5_gpio0 3 GPIO_ACTIVE_HIGH>;	/* GPIO004 = SLT_X8_RST_L, 低复位 */
	wake-gpios = <&s5_gpio0 7 GPIO_ACTIVE_HIGH>;
	vcc-pcie-supply = <&vdd_pcie_x8>;	/* P1 侧 PCIe 供电 */
	wlan-en-supply = <&vgfx_pwren>;		/* IX8024 核心供电, probe 前自动拉高 */
	max-link-speed = <4>;			/* Gen4 */
	status = "okay";
};

&pcie_x4_rc {
	linux,pci-domain = <2>;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x4_rc>;
	reset-gpios = <&s5_gpio0 2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&pcie_x2_rc {
	linux,pci-domain = <4>;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x2_rc>;
	/* 10G-1 (B_WAN, RTL8127) → P1 PCIE2。
	 * Y4 引脚: PERST=GPIO002, WAKE=GPIO012, CLKREQ=CLK_REQ2_L。 */
	reset-gpios = <&s5_gpio0 1 GPIO_ACTIVE_HIGH>;	/* GPIO002 = B_WAN_RST_L */
	wake-gpios = <&s5_gpio0 11 GPIO_ACTIVE_LOW>;	/* GPIO012 = B_WAN_PEWAKE_L */
	max-link-speed = <4>;			/* Gen4, 10GbE 跑 x1 需 Gen4 */
	status = "okay";
};

&pcie_x1_0_rc {
	linux,pci-domain = <3>;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x1_0_rc>;
	/* 10G-2 (GPP_WLAN, RTL8127) → P1 PCIE3 (SoC X1_0)。
	 * 引脚: PERST=GPIO005, WAKE=GPIO009, CLKREQ=CLK_REQ3_L。 */
	reset-gpios = <&s5_gpio0 4 GPIO_ACTIVE_HIGH>;	/* GPIO005 = M2_WLAN_RST_L */
	wake-gpios = <&s5_gpio0 8 GPIO_ACTIVE_LOW>;	/* GPIO009 = WLAN_WAKE_L */
	max-link-speed = <4>;			/* Gen4, 10GbE 跑 x1 需 Gen4 */
	status = "okay";
};

&pcie_x1_1_rc {
	linux,pci-domain = <1>;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x1_1_rc>;
	/* 2.5G (GPP_LOM, RTL8125) → P1 PCIE4 (SoC X1_1)。
	 * 引脚: PERST=GPIO006, WAKE=GPIO014, CLKREQ=CLK_REQ4_L。
	 */
	reset-gpios = <&s5_gpio0 5 GPIO_ACTIVE_HIGH>;	/* GPIO006 = A_LOM_RST_L */
	wake-gpios = <&s5_gpio0 13 GPIO_ACTIVE_LOW>;	/* GPIO014 = A_LOM_PEWAKE_L */
	max-link-speed = <4>;			/* Root port limit; the RTL8125 negotiates its own speed. */
	status = "okay";
};

