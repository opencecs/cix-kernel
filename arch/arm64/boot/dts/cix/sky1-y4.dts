/dts-v1/;

#include "sky1.dtsi"
#include "dt-bindings/usb/pd.h"
#include <dt-bindings/input/linux-event-codes.h>

/delete-node/ &reg_definition;

/* ---- 6.6 moved these cache-exception monitors out of sky1.dtsi (Radxa board dtsi) ---- */
/ {
	dsu_cache_exception: dsu_cache_exception {
		compatible = "cix,sky1_exception_dsu_cache";
		interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dsu_errirq", "dsu_faultirq";
		status = "disabled";
	};

	cache_exception_core4: cache_exception_core4 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU4>;
		interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core5: cache_exception_core5 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU5>;
		interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core6: cache_exception_core6 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU6>;
		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core7: cache_exception_core7 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU7>;
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core8: cache_exception_core8 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU8>;
		interrupts = <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core9: cache_exception_core9 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU9>;
		interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core10: cache_exception_core10 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU10>;
		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};

	cache_exception_core11: cache_exception_core11 {
		compatible = "cix,sky1_exception_core_cache";
		cpu = <&CPU11>;
		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core_errirq", "core_faultirq";
		interrupt-parent = <&gic>;
		status = "disabled";
	};
};

/* ---- 6.6 moved the CPU thermal zones to board dtsi; keep 6.1 content for parity ---- */
&thermal_zones {
		thermal_zone_cpu: thermal-zone1 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&scmi_sensor 10>;
			sustainable-power = <5000>;
			trips {
				m0_trip0: trip-point-0 {
					temperature = <60000>;
					hysteresis = <1000>;
					type = "passive";
				};
				m0_trip1: trip-point-1 {
					temperature = <85000>;
					hysteresis = <1000>;
					type = "passive";
				};
				m0_trip2: trip-point-2 {
					temperature = <98000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&m0_trip0>;
					cooling-device = <&CPU4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&m0_trip1>;
					cooling-device = <&CPU4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		/*thermal zone for CPU_M1*/
		thermal_zone_cpu_m1: thermal-zone2 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&scmi_sensor 8>;
			sustainable-power = <4500>;

			trips {
				m1_trip0: trip-point-0 {
					temperature = <60000>;
					hysteresis = <1000>;
					type = "passive";
				};
				m1_trip1: trip-point-1 {
					temperature = <85000>;
					hysteresis = <1000>;
					type = "passive";
				};
				m1_trip2: trip-point-2 {
					temperature = <98000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&m1_trip0>;
					cooling-device = <&CPU6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&m1_trip1>;
					cooling-device = <&CPU6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		/*thermal zone for CPU_B0*/
		thermal_zone_cpu_b0: thermal-zone3 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&scmi_sensor 11>;
			sustainable-power = <5500>;

			trips {
				b0_trip0: trip-point-0 {
					temperature = <60000>;
					hysteresis = <1000>;
					type = "passive";
				};
				b0_trip1: trip-point-1 {
					temperature = <85000>;
					hysteresis = <1000>;
					type = "passive";
				};
				b0_trip2: trip-point-2 {
					temperature = <98000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&b0_trip0>;
					cooling-device = <&CPU8 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&b0_trip1>;
					cooling-device = <&CPU8 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		/*thermal zone for CPU_B1*/
		thermal_zone_cpu_b1: thermal-zone4 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&scmi_sensor 9>;
			sustainable-power = <6000>;

			trips {
				b1_trip0: trip-point-0 {
					temperature = <60000>;
					hysteresis = <1000>;
					type = "passive";
				};
				b1_trip1: trip-point-1 {
					temperature = <85000>;
					hysteresis = <1000>;
					type = "passive";
				};
				b1_trip2: trip-point-2 {
					temperature = <98000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&b1_trip0>;
					cooling-device = <&CPU10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&b1_trip1>;
					cooling-device = <&CPU10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
};

/* 6.6 sky1.dtsi only defines pwm0/pwm1; FAN_OUT0 is FCH timer 3 at 0x04113000 */
&{/soc@0} {
	pwm3: pwm3@04113000 {
		compatible = "cix,sky1-pwm";
		reg = <0x0 0x04113000 0x0 0x1000>;
		clocks = <&scmi_clk CLK_TREE_FCH_TIMER_APB>,
					<&scmi_clk CLK_TREE_FCH_TIMER_FUN>;
		clock-names = "fch_pwm_apb_clk", "fch_pwm_func_clk";
		resets = <&src_fch SW_TIMER_RST_FUNC_N>;
		reset-names = "func_reset";
		#pwm-cells = <2>;
		status = "disabled";
	};
	pwm5: pwm5@04115000 {
		compatible = "cix,sky1-pwm";
		reg = <0x0 0x04115000 0x0 0x1000>;
		clocks = <&scmi_clk CLK_TREE_FCH_TIMER_APB>,
					<&scmi_clk CLK_TREE_FCH_TIMER_FUN>;
		clock-names = "fch_pwm_apb_clk", "fch_pwm_func_clk";
		resets = <&src_fch SW_TIMER_RST_FUNC_N>;
		reset-names = "func_reset";
		#pwm-cells = <2>;
		status = "disabled";
	};
};

/ {
	model = "MYT-AI-NAS-Y4";
	compatible = "myt,y4", "cix,sky1-edgeServer";

	chosen {
		stdout-path = &uart2;
	};

	/* J5 pin 197: GPIO011 -> A_LED_RUN -> Q2 -> D23 (high active). */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_y4_run_led>;

		led-run {
			label = "y4:green:run";
			gpios = <&s5_gpio0 10 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};
	
	vbus_typec_regulator_0: regulator-usb-c0 {
        compatible = "regulator-fixed";
        regulator-name = "vbus_typec0";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        gpio = <&s5_gpio1 8 GPIO_ACTIVE_LOW>; 
        enable-active-low;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_usb0_pwr>;
    };
    
    	vbus_typec_regulator_1: regulator-usb-c1 {
        status = "disabled"; /* Y4 has only J8/USBC0; no second Type-C circuit. */
        compatible = "regulator-fixed";
        regulator-name = "vbus_typec1";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        gpio = <&s5_gpio1 2 GPIO_ACTIVE_LOW>; 
        enable-active-low;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_usb1_pwr>;
    };
    
    	vdd_pcie_x8: regulator-vdd-pcie0 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_PCIE0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		/* Y4: 原 gpio = <&fch_gpio1 1> 已去掉。那个行号 (= Linux 75) 其实是
		 * I2S2_DATA_IN1/GPIO076 这个 pad, 也就是 MCU_BOOT, 不是 X8 供电脚 ——
		 * 保留会把 MCU 的 BOOT0 一直拉高, MCU 每次上电都进 ROM bootloader,
		 * 而且还会占住该 GPIO, 使 mcu_flash.sh 无法 export。
		 * Y4 的 8024/X8 供电已改为板级常开 (见下面 vgfx_pwren 的说明),
		 * 所以这里不再需要 gpio 控制。
		 *
		 * 注意编号: 若要恢复 GPIO 控制, X8 供电脚是 SoC GPIO075 = fch_gpio1 pad0
		 * (IOMUX 0x41700ec), 对应 Linux 全局行号 **74**, 不是 75 —— DTS 里没有
		 * gpio-ranges/gpio-line-names, 表格编号与 Linux 行号差 1。 */
		regulator-always-on;
	};

	/* V11: CN pin 136 (GPIO073) drives the IX8024 core regulator EN. */
	vgfx_pwren: regulator-vgfx-pwren {
		compatible = "regulator-fixed";
		regulator-name = "VGFX_PWREN";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mcu_ctrl>, <&pinctrl_vgfx_pwren>;
		gpio = <&fch_gpio0 30 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
	
	reg_audio_avdd: regulator-audio-avdd {
    	compatible = "regulator-fixed";
    	regulator-name = "audio_avdd";
    	regulator-min-microvolt = <3300000>;
    	regulator-max-microvolt = <3300000>;
    	regulator-always-on; 
	};
    
    sbu_switch_0: usb_c_switch_0 {
    compatible = "bl,1530tqfn","gpio-sbu-mux"; 
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_sbu_switch_0>;
    select-gpios = <&fch_gpio0 29 GPIO_ACTIVE_HIGH>;
    orientation-switch;

		port {
			dp_aux_data_0: endpoint {
				remote-endpoint = <&typec_dp_aux_0>;
			};
		};
	};

    sbu_switch_1: usb_c_switch_1 {
        status = "disabled"; /* Y4 has only J8/USBC0; no second Type-C circuit. */
    compatible = "bl,1530tqfn","gpio-sbu-mux"; 
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_sbu_switch_1>;
    select-gpios = <&fch_gpio1 4 GPIO_ACTIVE_HIGH>; 
    orientation-switch;

		port {
			dp_aux_data_1: endpoint {
				remote-endpoint = <&typec_dp_aux_1>;
			};
		};
	};

	sound {
            compatible = "cix,sky1-sound-card";
            model = "cix,sky1";
            status = "okay";
            /* Y4: 原 pinctrl-0 = <&pinctrl_audio_hp_det>(GPIO063) 已移除 ——
             * GPIO063 在 Y4 上是 MCU_RST, 该组已并入 pinctrl_mcu_ctrl。
             * 若 Y4 仍有耳机检测脚, 需要按新原理图补一组 pinctrl。 */
            /* Y4: 原 hpmicdet-gpios = <&fch_gpio0 20 GPIO_ACTIVE_LOW> 已去掉。
             * fch_gpio0 的行 20 就是 HDA_SDIN1/GPIO063 这个 pad (IOMUX 0x41700bc),
             * 在 Y4 上被复用成 MCU_RST, 不能同时当耳机检测输入 ——
             * 保留会让 mcu-boot.sh / mcu_flash.sh 无法 export gpio62 (EBUSY)。
             * 若 Y4 原理图上耳机检测挪到了别的脚, 按新原理图补 hpmicdet-gpios。 */
            
            audio-routing =
			"Headphone", "LOUT1",
			"Headphone", "ROUT1",
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Headphone", "Headphone Power",
			"Headphone", "Headphone Power",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"LINPUT1", "Main Mic",
			"LINPUT2", "Main Mic",
			"RINPUT1", "Headset Mic",
			"RINPUT2", "Headset Mic";

            codec_es8388: codec_es8388 {
            	status = "disabled";
		format = "i2s";
		mclk-fs = <256>;
		jack-det,hp;
                    cpu {
                            sound-dai = <&i2s0>;
                    };
                    codec {
                            sound-dai = <&es8388>;
                    };
            };
            
            dptx0_audio: dptx0_audio {
			status = "okay";

			format = "i2s";
			bitclock-inversion;
			jack-det,dpout;

			cpu {
				sound-dai = <&i2s5 0>;
			};

			codec {
				sound-dai = <&dp0>;
			};
		};

		dptx1_audio: dptx1_audio {
			status = "disabled";

			format = "i2s";
			bitclock-inversion;
			jack-det,dpout;

			cpu {
				sound-dai = <&i2s6 0>;
			};

			codec {
				sound-dai = <&dp1>;
			};
		};

		dptx2_audio: dptx2_audio {
			status = "okay";

			format = "i2s";
			bitclock-inversion;
			jack-det,dpout;

			cpu {
				sound-dai = <&i2s7 0>;
			};

			codec {
				sound-dai = <&dp2>;
			};
		};
    };

	/* Virtual display head: keeps a compositor output alive with no
	 * physical panel, for headless desktop and remote capture. */
	virtual-encoder@0 {
		compatible = "cix,virtual-display";
		status = "okay";

		port {
			vt_enc0_in: endpoint {
				remote-endpoint = <&dpu2_pipe1_out>;
			};
		};
	};
};

&fch_gpio0 {
	status = "okay";
};

&fch_gpio1 {
	status = "okay";
};

&fch_gpio2 {
	status = "okay";
};

&fch_gpio3 {
	status = "okay";
};

&s5_gpio0 {
	status = "okay";
};

&s5_gpio1 {
	status = "okay";
};

&hwclock {
	status = "okay";
};

&iomuxc_s5 {
        status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog_s5>;
	pinctrl_hog_s5: pinctrl_hog_s5 {
		sky1,pins = <
			CIX_PAD_GPIO040_FUNC_GPIO040  (PULL_UP|DS_LEVEL4) /* GPIO40 */
		>;
	};

	/* I2C1 物理走线在 SFI_I2C1 pad(S5 域 0x78/0x7c)，不在 iomuxc I2C1 pad。
	 * 实测: 配 SFI pad 后 MCU(0x42) 立即应答; iomuxc 域配置无效(空脚) */
	pinctrl_fch_i2c1_sfi: pinctrl_fch_i2c1_sfi {
		sky1,pins = <
			CIX_PAD_SFI_I2C1_SCL_FUNC_SFI_I2C1_SCL (PULL_UP|DS_LEVEL7)
			CIX_PAD_SFI_I2C1_SDA_FUNC_SFI_I2C1_SDA (PULL_UP|DS_LEVEL7)
		>;
	};

	/* SOC_I2C0 物理线走 SFI pad(核心板标注 I2C2/I3C0 复用脚), mux1=SF I3C0 控制器 */
	pinctrl_sf_i3c0: pinctrl-sf-i3c0 {
		sky1,pins = <
			CIX_PAD_SFI_I2C0_SCL_FUNC_SFI_I3C0_SCL (PULL_UP|DS_LEVEL7)
			CIX_PAD_SFI_I2C0_SDA_FUNC_SFI_I3C0_SDA (PULL_UP|DS_LEVEL7)
		>;
	};

	pinctrl_y4_run_led: pinctrl-y4-run-led {
		sky1,pins = <
			CIX_PAD_GPIO011_FUNC_GPIO011 (PULL_DOWN|DS_LEVEL4)
		>;
	};

	pinctrl_usb0: pinctrl_usb0_grp {
		sky1,pins = <
			CIX_PAD_GPIO013_FUNC_GPIO013  (PULL_UP|DS_LEVEL4)
		>;
	};
	pinctrl_usb0_pwr: pinctrl_usb0_pwr {
		sky1,pins = < 
			CIX_PAD_GPIO023_FUNC_GPIO023 (PULL_UP|DS_LEVEL4)
		>;
	};
	pinctrl_usb1: pinctrl_usb1_grp {
		sky1,pins = < 
			CIX_PAD_GPIO010_FUNC_GPIO010  (PULL_UP|DS_LEVEL4)
		>;
	};
	pinctrl_usb1_pwr: pinctrl_usb1_pwr {
		sky1,pins = <
			CIX_PAD_GPIO023_FUNC_GPIO023 (PULL_UP|DS_LEVEL4)
		>;
	};
	/* TCA9555@0x22 INT (INT_TCA955) -> GPIO019/SFI_GPIO4, 开漏低有效, 外部 10k 上拉 */
	pinctrl_tca9555_int: pinctrl_tca9555_int {
		sky1,pins = <
			CIX_PAD_GPIO019_FUNC_GPIO019 (DS_LEVEL4)
		>;
	};
        pinctrl_usb2: pinctrl_usb2_grp {
		sky1,pins = <
			CIX_PAD_SFI_GPIO0_FUNC_GPIO015 (PULL_DOWN |DS_LEVEL4)
		>;
	};
	pinctrl_usb3: pinctrl_usb3_grp {
		sky1,pins = <
			CIX_PAD_SFI_GPIO0_FUNC_GPIO015 (PULL_UP |DS_LEVEL4)
		>;
	};
        pinctrl_usb4: pinctrl_usb4_grp {
		sky1,pins = <
			CIX_PAD_GPIO022_FUNC_GPIO022 (PULL_DOWN |DS_LEVEL4)
		>;
	};
	pinctrl_usb5: pinctrl_usb5_grp {
		sky1,pins = <
			CIX_PAD_GPIO022_FUNC_GPIO022 (PULL_UP |DS_LEVEL4)
		>;
	};
	
	/* Keep firmware CLKREQ mux: changing it breaks link training on Y4.
	 * These groups configure only PERST and WAKE GPIOs (three cells each).
	 */
	pinctrl_pcie_x8_rc: pinctrl_pcie_x8_rc {
		sky1,pins = <
			CIX_PAD_GPIO004_FUNC_GPIO004 (DS_LEVEL4)
			CIX_PAD_GPIO008_FUNC_GPIO008 (PULL_DOWN|DS_LEVEL4)
		>;
	};

	pinctrl_pcie_x4_rc: pinctrl_pcie_x4_rc {
		sky1,pins = <
			CIX_PAD_GPIO003_FUNC_GPIO003 (PULL_DOWN|DS_LEVEL4)
		>;
	};
	pinctrl_pcie_x2_rc: pinctrl_pcie_x2_rc {
		sky1,pins = <
			CIX_PAD_GPIO002_FUNC_GPIO002 (PULL_DOWN|DS_LEVEL4)
			CIX_PAD_GPIO012_FUNC_GPIO012 (PULL_DOWN|DS_LEVEL4)
		>;
	};

	pinctrl_pcie_x1_0_rc: pinctrl_pcie_x1_0_rc {/*x1_0 = 10G-2 (GPP_WLAN, PCIE3)*/
		sky1,pins = <
			CIX_PAD_GPIO005_FUNC_GPIO005 (PULL_DOWN|DS_LEVEL4)
			CIX_PAD_GPIO009_FUNC_GPIO009 (PULL_DOWN|DS_LEVEL4)
		>;
	};

	pinctrl_pcie_x1_1_rc: pinctrl_pcie_x1_1_rc {/*x1_1 = 2.5G (GPP_LOM, PCIE4)*/
		sky1,pins = <
			CIX_PAD_GPIO006_FUNC_GPIO006 (PULL_DOWN|DS_LEVEL4)
			CIX_PAD_GPIO014_FUNC_GPIO014 (PULL_DOWN|DS_LEVEL4)
		>;
	};
	
	pinctrl0_husb311_int: pinctrl0-husb311-int {/* Type-C/PD IC interrupt pin */
		sky1,pins = <
			CIX_PAD_GPIO013_FUNC_GPIO013 (PULL_UP|DS_LEVEL4)
		>;
	};
	
	pinctrl1_husb311_int: pinctrl1-husb311-int {/* Type-C/PD IC interrupt pin */
		sky1,pins = <
			CIX_PAD_GPIO010_FUNC_GPIO010 (PULL_UP|DS_LEVEL4)
		>;
	};
};

&iomuxc {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: pinctrl_hog {
		sky1,pins = <
			CIX_PAD_GPIO144_FUNC_GPIO144 (PULL_DOWN|DS_LEVEL4) /* GPIO144 pdb0 */
			CIX_PAD_GPIO145_FUNC_GPIO145 (PULL_DOWN|DS_LEVEL4) /* GPIO145 pdb1 */
			CIX_PAD_GPIO146_FUNC_GPIO146 (PULL_DOWN|DS_LEVEL4) /* GPIO146 pdb2 */
			CIX_PAD_GPIO147_FUNC_GPIO147 (PULL_DOWN|DS_LEVEL4) /* GPIO147 pdb3 */
		>;
	};


	pinctrl_gmac0: pinctrl_gmac0 {
		sky1,pins =
		/* rfclk_25M */
		<CIX_PAD_GPIO121_FUNC_GMAC0_REFCLK_25M (ST|DS_LEVEL12)>,
		/* txc_trl */
		<CIX_PAD_GPIO122_FUNC_GMAC0_TX_CTL (ST|DS_LEVEL12)>,
		/* txd0 */
		<CIX_PAD_GPIO123_FUNC_GMAC0_TXD0 (ST|DS_LEVEL12)>,
		/* txd1 */
		<CIX_PAD_GPIO124_FUNC_GMAC0_TXD1 (ST|DS_LEVEL12)>,
		/* txd2 */
		<CIX_PAD_GPIO125_FUNC_GMAC0_TXD2 (ST|DS_LEVEL12)>,
		/* txd3 */
		<CIX_PAD_GPIO126_FUNC_GMAC0_TXD3 (ST|DS_LEVEL12)>,
		/* tx_clk */
		<CIX_PAD_GPIO127_FUNC_GMAC0_TX_CLK (ST|DS_LEVEL4)>,
		/* rx_ctl */
		<CIX_PAD_GPIO128_FUNC_GMAC0_RX_CTL (ST|DS_LEVEL4)>,

		/* rxd0 */
		<CIX_PAD_GPIO129_FUNC_GMAC0_RXD0 (ST|DS_LEVEL4)>,
		/* rxd1 */
		<CIX_PAD_GPIO130_FUNC_GMAC0_RXD1 (ST|DS_LEVEL4)>,
		/* rxd2 */
		<CIX_PAD_GPIO131_FUNC_GMAC0_RXD2 (ST|DS_LEVEL4)>,
		/* rxd3 */
		<CIX_PAD_GPIO132_FUNC_GMAC0_RXD3 (ST|DS_LEVEL4)>,
		/* rx_clk */
		<CIX_PAD_GPIO133_FUNC_GMAC0_RX_CLK (ST|DS_LEVEL4)>,
		/* mdc */
		<CIX_PAD_GPIO134_FUNC_GMAC0_MDC (ST|DS_LEVEL12)>,
		/* mdio */
		<CIX_PAD_GPIO135_FUNC_GMAC0_MDIO (ST|DS_LEVEL12)>;
	};

	pinctrl_gmac1: pinctrl_gmac1 {
		sky1,pins =
		/* rfclk_25M */
		<CIX_PAD_GPIO136_FUNC_GMAC1_REFCLK_25M (ST|DS_LEVEL12)>,
		/* txc_trl */
		<CIX_PAD_GPIO137_FUNC_GMAC1_TX_CTL (ST|DS_LEVEL12)>,
		/* txd0 */
		<CIX_PAD_GPIO138_FUNC_GMAC1_TXD0 (ST|DS_LEVEL12)>,
		/* txd1 */
		<CIX_PAD_GPIO139_FUNC_GMAC1_TXD1 (ST|DS_LEVEL12)>,
		/* txd2 */
		<CIX_PAD_GPIO140_FUNC_GMAC1_TXD2 (ST|DS_LEVEL12)>,
		/* txd3 */
		<CIX_PAD_GPIO141_FUNC_GMAC1_TXD3 (ST|DS_LEVEL12)>,
		/* tx_clk */
		<CIX_PAD_GPIO142_FUNC_GMAC1_TX_CLK (ST|DS_LEVEL12)>,
		/* rx_ctl */
		<CIX_PAD_GPIO143_FUNC_GMAC1_RX_CTL (ST|DS_LEVEL4)>,
		/* rxd0 */
		<CIX_PAD_GPIO144_FUNC_GMAC1_RXD0 (ST|DS_LEVEL4)>,
		/* rxd1 */
		<CIX_PAD_GPIO145_FUNC_GMAC1_RXD1 (ST|DS_LEVEL4)>,
		/* rxd2 */
		<CIX_PAD_GPIO146_FUNC_GMAC1_RXD2 (ST|DS_LEVEL4)>,
		/* rxd3 */
		<CIX_PAD_GPIO147_FUNC_GMAC1_RXD3 (ST|DS_LEVEL4)>,
		/* rx_clk */
		<CIX_PAD_GPIO148_FUNC_GMAC1_RX_CLK (ST|DS_LEVEL4)>,
		/* mdc */
		<CIX_PAD_GPIO149_FUNC_GMAC1_MDC (ST|DS_LEVEL12)>,
		/* mdio */
		<CIX_PAD_GPIO150_FUNC_GMAC1_MDIO (ST|DS_LEVEL12)>;
	};

	pinctrl_fch_i2c0: pinctrl_fch_i2c0 {
		sky1,pins = <
			CIX_PAD_I2C0_CLK_FUNC_I2C0_CLK (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C0_SDA_FUNC_I2C0_SDA (PULL_UP|DS_LEVEL7)
		>;
	};

	pinctrl_fch_i2c1: pinctrl_fch_i2c1 {
		sky1,pins = <
			CIX_PAD_I2C1_CLK_FUNC_I2C1_CLK (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C1_SDA_FUNC_I2C1_SDA (PULL_UP|DS_LEVEL7)
		>;
	};

	pinctrl_fch_i2c2: pinctrl_fch_i2c2 {
		sky1,pins = <
			CIX_PAD_I2C2_SCL_FUNC_I2C2_SCL (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_I2C2_SDA_FUNC_I2C2_SDA (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	pinctrl_fch_i2c3: pinctrl_fch_i2c3 {
		sky1,pins = <
			CIX_PAD_I2C3_CLK_FUNC_I2C3_CLK (PULL_UP|ST|DS_LEVEL12)
			CIX_PAD_I2C3_SDA_FUNC_I2C3_SDA (PULL_UP|ST|DS_LEVEL12)
		>;
	};

	pinctrl_fch_i2c4: pinctrl_fch_i2c4 {
		sky1,pins = <
			CIX_PAD_I2C4_CLK_FUNC_I2C4_CLK (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C4_SDA_FUNC_I2C4_SDA (PULL_UP|DS_LEVEL7)
		>;
	};
	
	pinctrl_fch_i2c5: pinctrl_fch_i2c5 {
		sky1,pins = <
			CIX_PAD_I2C5_SCL_FUNC_I2C5_SCL (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C5_SDA_FUNC_I2C5_SDA (PULL_UP|DS_LEVEL7)
		>;
	};
	
	pinctrl_fch_i2c6: pinctrl_fch_i2c6 {
		sky1,pins = <
			CIX_PAD_I2C6_SCL_FUNC_I2C6_SCL (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C6_SDA_FUNC_I2C6_SDA (PULL_UP|DS_LEVEL7)
		>;
	};
	
	pinctrl_fch_i2c7: pinctrl_fch_i2c7 {
		sky1,pins = <
			CIX_PAD_I2C7_SCL_FUNC_I2C7_SCL (PULL_UP|DS_LEVEL7)
			CIX_PAD_I2C7_SDA_FUNC_I2C7_SDA (PULL_UP|DS_LEVEL7)
		>;
	};
	
	pinctrl_fch_uart0: pinctrl_fch_uart0 {
		sky1,pins = <
			CIX_PAD_UART0_TXD_FUNC_UART0_TXD (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART0_RXD_FUNC_UART0_RXD (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART0_CTS_FUNC_UART0_CTS (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART0_RTS_FUNC_UART0_RTS (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	pinctrl_fch_uart1: pinctrl_fch_uart1 {
                sky1,pins = <
			CIX_PAD_UART1_TXD_FUNC_UART1_TXD (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART1_RXD_FUNC_UART1_RXD (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART1_CTS_FUNC_UART1_CTS (PULL_UP|ST|DS_LEVEL7)
			CIX_PAD_UART1_RTS_FUNC_UART1_RTS (PULL_UP|ST|DS_LEVEL7)
                >;
        };
        
        pinctrl_fch_uart3: pinctrl_fch_uart3 {
		sky1,pins = <
			CIX_PAD_UART3_TXD_FUNC_UART3_TXD (PULL_UP|DS_LEVEL7)
			CIX_PAD_UART3_RXD_FUNC_UART3_RXD (PULL_UP|DS_LEVEL7)
		>;
	};

	pinctrl_fch_uart4: pinctrl_fch_uart4 {
		sky1,pins = <
			CIX_PAD_UART4_CSU_PM_TXD_FUNC_UART4_CSU_PM_TXD (PULL_UP|DS_LEVEL7)
			CIX_PAD_UART4_CSU_PM_RXD_FUNC_UART4_CSU_PM_RXD (PULL_UP|DS_LEVEL7)
		>;
	};

	pinctrl_fch_uart5: pinctrl_fch_uart5 {
                sky1,pins = <
			CIX_PAD_UART5_CSU_SE_TXD_FUNC_UART5_CSU_SE_TXD (PULL_UP|DS_LEVEL7)
			CIX_PAD_UART5_CSU_SE_RXD_FUNC_UART5_CSU_SE_RXD (PULL_UP|DS_LEVEL7)
                >;
        };

        pinctrl_fch_uart2: pinctrl_fch_uart2 {
                sky1,pins = <
			CIX_PAD_UART2_TXD_FUNC_UART2_TXD (PULL_UP|DS_LEVEL7)
			CIX_PAD_UART2_RXD_FUNC_UART2_RXD (PULL_UP|DS_LEVEL7)
                >;
        };
        
        pinctrl_substrate_i2s0: pinctrl_substrate_i2s0 {
		sky1,pins = <
			/* I2S0_SCK */
			CIX_PAD_HDA_BITCLK_FUNC_I2S0_SCK    	(PULL_DOWN|ST|DS_LEVEL12)
			/* I2S0_DATA_IN */
			CIX_PAD_HDA_RST_L_FUNC_I2S0_DATA_IN 	(PULL_DOWN|ST|DS_LEVEL12)
			/* I2S0_MCLK */
			CIX_PAD_HDA_SDIN0_FUNC_I2S0_MCLK    	(PULL_DOWN|ST|DS_LEVEL12)
			/* I2S0_DATA_OUT */
		
			CIX_PAD_HDA_SDOUT0_FUNC_I2S0_DATA_OUT 	(PULL_UP|ST|DS_LEVEL12)
			/* I2S0_WS */
			CIX_PAD_HDA_SYNC_FUNC_I2S0_WS 	    	(PULL_UP|ST|DS_LEVEL12)
		>;
	};
	
	pinctrl_substrate_i2s4: pinctrl_substrate_i2s4 {
		sky1,pins = <
			//CIX_PAD_GPIO090_FUNC_I2S4_MCLK_LB      (ST|DS_LEVEL12) 	  /* i2s4_mclk_lb */
			CIX_PAD_GPIO091_FUNC_I2S4_SCK_LB       (ST|DS_LEVEL12)    /* i2s4_sck_lb */
			CIX_PAD_GPIO092_FUNC_I2S4_WS_LB        (ST|DS_LEVEL12)    /* i2s4_ws_lb */
			CIX_PAD_GPIO093_FUNC_I2S4_DATA_IN_LB   (ST|DS_LEVEL12)    /* i2s4_data_in_lb */
			CIX_PAD_GPIO094_FUNC_I2S4_DATA_OUT_LB  (ST|DS_LEVEL12) 	  /* i2s4_data_out_lb */
		>;
	};
	
	pinctrl_sbu_switch_0:pinctrl_sbu_switch_0{
		sky1,pins = <
			CIX_PAD_I2S2_RWS_FUNC_GPIO072 (PULL_DOWN|DS_LEVEL4)
		>;
	};
	
	pinctrl_sbu_switch_1:pinctrl_sbu_switch_1{
		sky1,pins = <
			CIX_PAD_I2S2_DATA_OUT2_FUNC_GPIO079 (PULL_DOWN|DS_LEVEL4)
		>;
	};
	
	pinctrl_fch_fan0: pinctrl_fch_fan0 {
		sky1,pins = <
			CIX_PAD_UART1_TXD_FUNC_FAN_OUT0 (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	/* FANTACH0_1V8 is UART1_RXD. Use GPIO100 on FCH GPIO1 line 25
	 * to count tachometer falling edges.
	 */
	pinctrl_fan1_tach: pinctrl_fan1_tach {
		sky1,pins = <
			CIX_PAD_UART1_RXD_FUNC_GPIO100 (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	pinctrl_fch_fan2: pinctrl_fch_fan2 {
		sky1,pins = <
			CIX_PAD_UART0_CTS_FUNC_FAN_OUT2 (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	pinctrl_fan2_tach: pinctrl_fan2_tach {
		sky1,pins = <
			CIX_PAD_UART0_RTS_FUNC_GPIO098 (PULL_UP|ST|DS_LEVEL7)
		>;
	};

	/* Y4: MCU 控制脚(SoC 直连)。MCU_RST=GPIO063(经 S8050 反相: 高=复位),
	 * MCU_BOOT=GPIO076(经 MT9700: 高=BOOT0 有效)。原挂在 TCA9555(U58 IO10/IO11,
	 * gpio2024/2025)上, Y4 去掉 TCA9555 后直连 SoC, 等飞线后由 mcu-boot.sh 驱动。
	 * 注意: GPIO076 原先被 pinctrl_pcie_x8_pwr 占用(X8 供电, 实际供电脚是
	 * fch_gpio1 1=GPIO075, 该组是历史误标), GPIO063 原先被 pinctrl_audio_hp_det
	 * 占用, 两者已从原组移除。 */
	pinctrl_mcu_ctrl: pinctrl_mcu_ctrl {
		sky1,pins = <
			CIX_PAD_HDA_SDIN1_FUNC_GPIO063 (PULL_DOWN|DS_LEVEL4)
			CIX_PAD_I2S2_DATA_IN1_FUNC_GPIO076 (PULL_DOWN|DS_LEVEL4)
		>;
	};
	
	pinctrl_rtc_int:pinctrl_rtc_int{
		sky1,pins = <
			CIX_PAD_GPIO153_FUNC_GPIO153 (PULL_UP|DS_LEVEL4)
		>;
	};
	
	pinctrl_vgfx_pwren: pinctrl_vgfx_pwren{
		sky1,pins = <
			CIX_PAD_I2S2_TSCK_FUNC_GPIO073 (PULL_UP|DS_LEVEL4)
		>;
	};
};

&dp0 {
	sound-name-prefix = "DP0";
	status = "okay";
	
	phys = <&usbc0_dp_phy>;
	cix,delay_after_hpd = <500>;
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dp0_0_in: endpoint {
				remote-endpoint = <&dpu0_pipe0_out>;
			};
		};
		port@1 {
			reg = <1>;
			dp0_1_in: endpoint {
				remote-endpoint = <&dpu0_pipe1_out>;
			};
		};
	};
};

/* Y4 V11 routes DP0 to J8 and DP2 to CON1. DP1 has no connector. */
&dp1 {
	sound-name-prefix = "DP1";
	status = "disabled";
	cix,delay_after_hpd = <500>;
	phys = <&usbc1_dp_phy>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dp1_0_in: endpoint {
				remote-endpoint = <&dpu1_pipe0_out>;
			};
		};
		port@1 {
			reg = <1>;
			dp1_1_in: endpoint {
				remote-endpoint = <&dpu1_pipe1_out>;
			};
		};
	};
};

&dp2 {
	sound-name-prefix = "DP2";
	status = "okay";
	
	
	/* DP2 uses its integrated eDP PHY at 0x1414c000, not a MIPI RX PHY. */
	

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dp2_0_in: endpoint {
				remote-endpoint = <&dpu2_pipe0_out>;
			};
		};
		/* eDP second pipe donated to the virtual display head:
		 * the Y4 product has no embedded panel. */
		port@1 {
			reg = <1>;
			status = "disabled";
		};
		port@2 {
			reg = <2>;
		};
	};
};

&cix_dphy_2 {
    status = "disabled"; /* No CSI receiver attached to the Y4 DisplayPort connector. */
};

&dpu0 {
	status = "okay";

	aclk_freq_fixed = <800000000>;
	pipeline@0 {
		lpu_raxi_aoutstdcapb = <32>;
		lpu_raxi_boutstdcapb = <32>;
		lpu_raxi_ben = <0>;
		lpu_raxi_burstlen = <16>;
		lpu_raxi_arqos = <15>;
		lpu_raxi_ord = <0>;
		lpu_waxi_outstdcapb = <16>;
		lpu_waxi_burstlen = <16>;
		lpu_waxi_awqos = <15>;
		lpu_waxi_ord = <0>;
		lpu_l0_arcache = <3>;
		lpu_l1_arcache = <3>;
		lpu_l2_arcache = <3>;
		lpu_l3_arcache = <3>;
		lpu_lw_arcache = <3>;
		port {
			dpu0_pipe0_out: endpoint {
				remote-endpoint = <&dp0_0_in>;
			};
		};
	};

	pipeline@1 {
		port {
			dpu0_pipe1_out: endpoint {
				remote-endpoint = <&dp0_1_in>;
			};
		};
	};
};

&dpu1 {
	status = "disabled";

	aclk_freq_fixed = <800000000>;
	pipeline@0 {
		lpu_raxi_aoutstdcapb = <32>;
		lpu_raxi_boutstdcapb = <32>;
		lpu_raxi_ben = <0>;
		lpu_raxi_burstlen = <16>;
		lpu_raxi_arqos = <15>;
		lpu_raxi_ord = <0>;
		lpu_waxi_outstdcapb = <16>;
		lpu_waxi_burstlen = <16>;
		lpu_waxi_awqos = <15>;
		lpu_waxi_ord = <0>;
		lpu_l0_arcache = <3>;
		lpu_l1_arcache = <3>;
		lpu_l2_arcache = <3>;
		lpu_l3_arcache = <3>;
		lpu_lw_arcache = <3>;
		port {
			dpu1_pipe0_out: endpoint {
				remote-endpoint = <&dp1_0_in>;
			};
		};
	};

	pipeline@1 {
		port {
			dpu1_pipe1_out: endpoint {
				remote-endpoint = <&dp1_1_in>;
			};
		};
	};
};

&dpu2 {
	status = "okay";

	aclk_freq_fixed = <800000000>;
	pipeline@0 {
		lpu_raxi_aoutstdcapb = <32>;
		lpu_raxi_boutstdcapb = <32>;
		lpu_raxi_ben = <0>;
		lpu_raxi_burstlen = <16>;
		lpu_raxi_arqos = <15>;
		lpu_raxi_ord = <0>;
		lpu_waxi_outstdcapb = <16>;
		lpu_waxi_burstlen = <16>;
		lpu_waxi_awqos = <15>;
		lpu_waxi_ord = <0>;
		lpu_l0_arcache = <3>;
		lpu_l1_arcache = <3>;
		lpu_l2_arcache = <3>;
		lpu_l3_arcache = <3>;
		lpu_lw_arcache = <3>;
		port {
			dpu2_pipe0_out: endpoint {
				remote-endpoint = <&dp2_0_in>;
			};
		};
	};

	pipeline@1 {
		port {
			dpu2_pipe1_out: endpoint {
				remote-endpoint = <&vt_enc0_in>;
			};
		};
	};
};


&aeu0 {
	status = "disabled";
};

&aeu1 {
	status = "disabled";
};

&aeu2 {
	status = "disabled";
};

&aeu3 {
	status = "disabled";
};

&aeu4 {
	status = "disabled";
};

&gmac_rcsu {
	status = "disabled";
};

&usbc_phy0 {
	orientation-switch;
	svid = <0xff01>;
	status = "okay";
	default_conf = /bits/ 8 <0x03>;
	mode-switch;
	phy-status = "usb"; //add for gop,modified at startup
	
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdpphy0_lane_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_phy_sw>;
		};
	};
};

&usb3_phy0 {
	status = "okay";
};

&usbc0_dp_phy {
	status = "okay";
};

&sf_i3c0 {
	status = "disabled"; /* SAFE: sf时钟链未验证,勿使能 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sf_i3c0>;
};

&sky1_usbss_0 {
	sof_clk_freq = <8000000>;
	lpm_clk_freq = <32000>;
	pinctrl-names = "default";
	status = "okay";
};

&usbss_0 {
	status = "okay";
	dr_mode = "otg"; /* J8: HUSB311 selects host/device from CC negotiation. */
	usb-role-switch;
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		cdnsp_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbc_phy1 {
	status = "okay";
	svid = <0xff01>;
	default_conf = /bits/ 8 <0x03>;
	phy-status = "usb"; //add for gop,modified at startup

	/* No Type-C1 connector on Y4: do not wait for its disabled graph supplier. */

};

&usb3_phy1 {
	status = "okay";
};

&usbc1_dp_phy {
	status = "disabled";
};

&sky1_usbss_1 {
	sof_clk_freq = <8000000>;
	lpm_clk_freq = <32000>;
	pinctrl-names = "default"; 
	status = "disabled"; /* USBC1 is not routed to a Y4 USB connector. */
};

&usbss_1 {
	status = "disabled"; /* USBC1 is not routed to a Y4 USB connector. */
	dr_mode = "otg";
	usb-role-switch;
	
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		cdnsp_1_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc1_role_sw>;
		};
	};
};


&usbc_phy2 {
	status = "okay";
	default_conf = /bits/ 8 <0x03>;
	phy-status = "usb"; /* combo PHY 强制 USB 模式，否则 SS 链路不通(EVB 同款配置) */
};

&usbc2_dp_phy {
	status = "okay";
};

&usb3_phy2 {
	status = "okay";
};

&sky1_usbss_2 {
	/* Y4 J13: Gen2 fails with Teclast 0dd8:1f40; retain verified 5Gbps compatibility. */
	ssp-disable;
	sof_clk_freq = <8000000>;
	lpm_clk_freq = <32000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb2>;
	//pwren-gpios = <&s5_gpio1 0 GPIO_ACTIVE_LOW>; 
	status = "okay";
