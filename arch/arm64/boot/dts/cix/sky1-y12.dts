&pcie_x8_rc {
	/*
	 * Physical front slots 1..12: IX8024 downstream PCI device
	 * numbers, relative to the switch secondary bus. The bus number
	 * itself is allocated at enumeration and is not a slot identity.
	 * Derived from the A..L port order in the Y12 reference design.
	 */
	myt,slot-downstream-ports = <8 7 1 2 4 5 11 10 9 6 0 3>;
	/* x1 slots B/C/E/F/H/I/K/L, in physical order 3/4/5/6/2/1/8/7.
	 * Turn these rails on before releasing the upstream PERST#.
	 */
	myt,slot-power-gpios = <&tca9555_0 3 GPIO_ACTIVE_HIGH>,
			       <&tca9555_0 5 GPIO_ACTIVE_HIGH>,
			       <&tca9555_0 9 GPIO_ACTIVE_HIGH>,
			       <&tca9555_0 11 GPIO_ACTIVE_HIGH>,
			       <&tca9555_0 15 GPIO_ACTIVE_HIGH>,
			       <&tca9555_1 1 GPIO_ACTIVE_HIGH>,
			       <&tca9555_1 5 GPIO_ACTIVE_HIGH>,
			       <&tca9555_1 7 GPIO_ACTIVE_HIGH>;
	/* SN74LVC1G66 gates connect the x2 socket presence to IX8024.
	 * Slots 9 to 12. IX8024 P0..P3PWRENABLE drive the four regulators.
	 * The separate x1 PERST# branches are NC on the V11 schematic.
	 */
	myt,slot-presence-gate-gpios = <&tca9555_1 3 GPIO_ACTIVE_HIGH>,
				      <&tca9555_0 13 GPIO_ACTIVE_HIGH>,
				      <&tca9555_0 1 GPIO_ACTIVE_HIGH>,
				      <&tca9555_0 7 GPIO_ACTIVE_HIGH>;
	max-payload = <256>;
	sky1,fixed-mps = <256>;
	linux,pci-domain = <3>;
	/* Y12: contain PCIe errors without panicking the whole SoC. */
	/delete-property/ sky1,aer-uncor-panic;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x8_rc>;
	reset-gpios = <&s5_gpio0 3 GPIO_ACTIVE_HIGH>;	/* GPIO004 = SLT_X8_RST_L, 低复位 */
	wake-gpios = <&s5_gpio0 7 GPIO_ACTIVE_HIGH>;
	vcc-pcie-supply = <&vdd_pcie_x8>;	/* P1 侧 PCIe 供电 */
	wlan-en-supply = <&vgfx_pwren>;		/* IX8024 核心供电, probe 前自动拉高 */
	max-link-speed = <4>;			/* Gen4 */
	status = "okay";
};

&pcie_x4_rc {
	linux,pci-domain = <0>;
	/* Y12: contain PCIe errors without panicking the whole SoC. */
	/delete-property/ sky1,aer-uncor-panic;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x4_rc>;
	reset-gpios = <&s5_gpio0 2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&pcie_x2_rc {
	linux,pci-domain = <4>;
	/* Keep correctable AER accounting on the dedicated RTL8127 root. */
	myt,aer-log-ce-ratelimited;
	/* Y12: contain PCIe errors without panicking the whole SoC. */
	/delete-property/ sky1,aer-uncor-panic;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x2_rc>,<&pinctrl_4g_5g_disable>;
	reset-gpios = <&s5_gpio0 1 GPIO_ACTIVE_HIGH>;
	wake-gpios = <&s5_gpio0 11 GPIO_ACTIVE_LOW>;
	max-link-speed = <4>;
	num-lanes = <1>;	/* Y12 每个 RTL8127 只接 1 lane, 第二 lane 未使用 */
	status = "okay";
};

&pcie_x1_0_rc {
	linux,pci-domain = <2>;
	/* Y12: contain PCIe errors without panicking the whole SoC. */
	/delete-property/ sky1,aer-uncor-panic;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x1_0_rc>;
	reset-gpios = <&s5_gpio0 4 GPIO_ACTIVE_HIGH>;
	wake-gpios = <&s5_gpio0 8 GPIO_ACTIVE_LOW>;
	max-link-speed = <4>;
	status = "okay";
};

&pcie_x1_1_rc {
	linux,pci-domain = <1>;
	/* Y12: contain PCIe errors without panicking the whole SoC. */
	/delete-property/ sky1,aer-uncor-panic;
	plat-evk;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie_x1_1_rc>;
	reset-gpios = <&s5_gpio0 5 GPIO_ACTIVE_HIGH>;
	wake-gpios = <&s5_gpio0 13 GPIO_ACTIVE_LOW>;
	max-link-speed = <4>;
	status = "okay";
};

