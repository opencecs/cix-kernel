/* V2 schematic review (2026-10-21): four expanders are 0x20..0x23.
 * IX8024 hot-plug is a 4x8 GPIO function (ATNLED/ATNBUTTON/MRL/RESET/
 * PRSNT/PWRENABLE/PWRFAULT/PWRGOOD); the schematic exposes these through
 * the expander/slot control nets. Keep EP_DET/INT_HOTPLUG unbound until the
 * exact A9555 port and SoC interrupt routing is confirmed against the pin index.
 */
/*
 * TCA9555 I/O expanders on P1 I2C1
 * 槽位编号 = 板上物理位置: 第一行左→右 1~6 = J20,J19,J10,J4,J15,J16;
 *            第二行左→右 7~12 = J23,J22,J21,J18,J1,J12 (与 MCU 固件寄存器编号一致)
 * 0x20 = U55 (M.2 A~H PERST/PWREN; 字母=原理图编号: A=J1=槽11 B=J10=槽3 C=J4=槽4
 *   D=J12=槽12 E=J15=槽5 F=J16=槽6 G=J18=槽10 H=J19=槽2)
 * 0x21 = U58 (M.2 I~L PERST/PWREN + INT -> GPIO018 = s5_gpio1 line3: I=J20=槽1 J=J21=槽9 K=J22=槽8 L=J23=槽7
 *   + MCU_RST/MCU_BOOT + VGFX_PWREN = SY8370TMC EN, IX8024 核心供电 IO_12)
 * 0x22 = U57 按键 KEY1~12 (INT -> GPIO019 = s5_gpio1 line4; line n = KEY_n+1, 编号=SSD 通道序, 与物理槽位号不同)
 * 0x23 = U69 运行灯 RUN_LED1~12 (line n = LED_n+1, 编号=SSD 通道序, 与物理槽位号不同)
 * Note: ti,tca9555 not in pca953x of_match, use nxp,pca9555 (compatible)
 */
&i2c1 {
	tca9555_0: tca9555@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "nc", "slot11-presence-gate", "B-perst", "B-pwren", "C-perst", "C-pwren", "nc", "slot12-presence-gate", "E-perst", "E-pwren", "F-perst", "F-pwren", "nc", "slot10-presence-gate", "H-perst", "H-pwren";
		status = "okay";
	};

	tca9555_1: tca9555@21 {
		compatible = "nxp,pca9555";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&s5_gpio1>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tca9555_21_int>;
		gpio-line-names = "I-perst", "I-pwren", "nc", "slot9-presence-gate", "K-perst", "K-pwren", "L-perst", "L-pwren", "mcu-rst", "mcu-boot", "ix8024-pwren", "nc", "y12-slot2-present", "y12-slot1-present", "y12-slot8-present", "y12-slot7-present";
		status = "okay";
	};

	tca9555_2: tca9555@22 {
		compatible = "nxp,pca9555";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&s5_gpio1>;
		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;	/* GPIO019 = s5_gpio1 line4 */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tca9555_int>;
		/* U57: KEY1-12 (IO_00~07, IO_10~13) + EP_DET B/C/E/F
		 * (IO_14~17 = line 12~15, 对应物理槽位 3/4/5/6). */
		gpio-line-names = "key1", "key2", "key3", "key4",
				  "key5", "key6", "key7", "key8",
				  "key9", "key10", "key11", "key12",
				  "y12-slot3-present", "y12-slot4-present", "y12-slot5-present", "y12-slot6-present";
		status = "okay";
	};

	tca9555_3: tca9555@23 {
		compatible = "nxp,pca9555";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};
};

/*
 * CIX FchTimerLib assigns FAN_OUT0 to timer 3 and FAN_OUT2 to timer 5.
 * Its register address is 0x04110000 + timer * 0x1000.
 * Verify both connector groups on the first hardware bring-up.
 */
&pwm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_fan0>;
	myt,keep-fan-pwm-running;
	status = "okay";
};

&pwm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fch_fan1>;
	myt,keep-fan-pwm-running;
	status = "okay";
};

/ {
	/* hwmon fan1..3 are physical FAN2, FAN3, FAN5. */
	pwm-fan-out0 {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tach0 &pinctrl_tach_fan5>;
		interrupts-extended = <&fch_gpio1 25 IRQ_TYPE_EDGE_FALLING>,
				      <&fch_gpio0 13 IRQ_TYPE_EDGE_FALLING>,
				      <&s5_gpio0 14 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2 2 2>;
		compatible = "myt,y12-soc-fan", "pwm-fan";
		pwms = <&pwm3 0 40000>;
	};

	/* hwmon fan1..3 are physical FAN1, FAN4, FAN6. */
	pwm-fan-out2 {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tach2 &pinctrl_tach_fan6>;
		interrupts-extended = <&fch_gpio1 23 IRQ_TYPE_EDGE_FALLING>,
				      <&fch_gpio0 12 IRQ_TYPE_EDGE_FALLING>,
				      <&s5_gpio0 15 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2 2 2>;
		compatible = "myt,y12-soc-fan", "pwm-fan";
		pwms = <&pwm5 0 40000>;
	};
};

/* Y12 CPU temperature zones for the kernel SoC fan policy.
 * Sensor IDs follow the SCMI labels on this board:
 *   CPU_M0=11, CPU_M1=9, CPU_B0=12, CPU_B1=10.
 */
&thermal_zones {
	thermal_zone_cpu_m0: tz-cpu-m0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&scmi_sensor 10>;
		trips {
			cpu_m0_trip0: trip-point-0 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_m0_trip1: trip-point-1 {
				temperature = <85000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_m0_trip2: trip-point-2 {
				temperature = <98000>;
				hysteresis = <1000>;
				type = "critical";
			};
		};
	};

	thermal_zone_cpu_m1: tz-cpu-m1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&scmi_sensor 8>;
		trips {
			cpu_m1_trip0: trip-point-0 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_m1_trip1: trip-point-1 {
				temperature = <85000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_m1_trip2: trip-point-2 {
				temperature = <98000>;
				hysteresis = <1000>;
				type = "critical";
			};
		};
	};

	thermal_zone_cpu_b0: tz-cpu-b0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&scmi_sensor 11>;
		trips {
			cpu_b0_trip0: trip-point-0 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_b0_trip1: trip-point-1 {
				temperature = <85000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_b0_trip2: trip-point-2 {
				temperature = <98000>;
				hysteresis = <1000>;
				type = "critical";
			};
		};
	};

	thermal_zone_cpu_b1: tz-cpu-b1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&scmi_sensor 9>;
		trips {
			cpu_b1_trip0: trip-point-0 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_b1_trip1: trip-point-1 {
				temperature = <85000>;
				hysteresis = <1000>;
				type = "passive";
			};
			cpu_b1_trip2: trip-point-2 {
				temperature = <98000>;
				hysteresis = <1000>;
				type = "critical";
			};
		};
	};
};

/ {
	/*
	 * Board maintenance wiring. Both lines are asserted high at the
	 * expander; reset inverts externally before reaching MCU NRST.
	 */
	mcu-maintenance {
		reset-gpios = <&tca9555_1 8 GPIO_ACTIVE_HIGH>;
		boot-gpios = <&tca9555_1 9 GPIO_ACTIVE_HIGH>;
	};

	myt_slot_hotplug: myt-slot-hotplug {
		compatible = "myt,y12-slot-hotplug";
		/* Physical slot numbers for the GPIO arrays below, in order. */
		myt,physical-slots = <3 4 5 6 2 1 8 7>;
		perst-gpios = <&tca9555_0 2 0>, <&tca9555_0 4 0>, <&tca9555_0 8 0>, <&tca9555_0 10 0>, <&tca9555_0 14 0>, <&tca9555_1 0 0>, <&tca9555_1 4 0>, <&tca9555_1 6 0>;
		det-gpios = <&tca9555_2 12 GPIO_ACTIVE_LOW>, <&tca9555_2 13 GPIO_ACTIVE_LOW>, <&tca9555_2 14 GPIO_ACTIVE_LOW>, <&tca9555_2 15 GPIO_ACTIVE_LOW>, <&tca9555_1 12 GPIO_ACTIVE_LOW>, <&tca9555_1 13 GPIO_ACTIVE_LOW>, <&tca9555_1 14 GPIO_ACTIVE_LOW>, <&tca9555_1 15 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

#include "sky1-myt-cp6187.dtsi"
