# Y4 板级内核选项（6.6.89）—— 在 cix.config 之后、debian.config 之前合并
#
# 这些是"厂商 BSP 不默认开、但 Y4 必须随内核编"的组件。
# 与 configs/base-6.6.89.config 的关系：base 是包含本片段结果的合并不动点。

# ---- Mali GPU KMD（r54p1-11eac0，树内编译，不用预编译 .ko）----
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_DEVFREQ=y
CONFIG_MALI_TRACE_POWER_GPU_WORK_PERIOD=y
CONFIG_MALI_GATOR_SUPPORT=y
CONFIG_MALI_PLATFORM_NAME="sky1"
CONFIG_MALI_BASE_MODULES=y
CONFIG_MALI_MEMORY_GROUP_MANAGER=y
CONFIG_MALI_PROTECTED_MEMORY_ALLOCATOR=y
CONFIG_DMA_SHARED_BUFFER_TEST_EXPORTER=n

# ---- VPU amvx（1.0.1，树内编译，V4L2 stateful M2M）----
CONFIG_VIDEO_LINLON=y
CONFIG_VIDEO_LINLON_PRINT_FILE=y
CONFIG_VIDEO_LINLON_FTRACE=n

# ---- 后摩 XH2A NPU（v1.5.0，树内编译）----
CONFIG_XH2A_DRV=y

# ---- OpenCecs PID1 紧急重启 ----
CONFIG_OPENCECS_LIFECYCLE_EMERGENCY=y

# ---- RTL8127 10G：使用 6.1 树同版驱动（11.016.00，含 fiber/Y4 修复），按 6.1 行为内建 ----
CONFIG_R8127=y

# ---- NAS：NFS 服务端（镜像自带 rpc.nfsd/exportfs/nfsdcld 用户态）----
# 6.1 由厂商 cix.config 提供 NFSD=m；6.6 的 cix.config 删掉了这些行，
# 而我们的 base 原本是 "# CONFIG_NFSD is not set"，导致整组丢失。
CONFIG_NFSD=m
CONFIG_NFSD_V2_ACL=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_SUNRPC_GSS=m

# ---- NAS：NFS 客户端（镜像自带 mount.nfs）----
CONFIG_NFS_FS=m
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFS_V4_1_MIGRATION=y

# ---- Docker/tc 与 6.1 对齐（6.6 cix.config 不再提供）----
CONFIG_NET_SCH_TBF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_XFRM=m
CONFIG_XFRM_INTERFACE=m

# ---- 未使用的 ST 加速度计 SPI 驱动（Y4 无此硬件，关闭以消除设备表告警）----
# CONFIG_IIO_ST_ACCEL_SPI_3AXIS is not set
# ---- SoC 内置 NPU（Arm China 周易/AIPU，树内编译）----
CONFIG_ARMCHINA_NPU=y
CONFIG_ARMCHINA_NPU_ARCH_V3=y
CONFIG_ARMCHINA_NPU_SOC_SKY1=y
