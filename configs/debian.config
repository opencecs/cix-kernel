# Debian/systemd root, using the production CIX configuration plus latest BSP.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EFI_PARTITION=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_TLS=y
CONFIG_BONDING=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_PWM_SKY1=y
CONFIG_SENSORS_PWM_FAN=y

# The Y4 product ships no NPU card today, but the Houmo M50 (XH2A) can
# be attached later: build the host driver as a module so it is ready
# to load on card enumeration without any boot-time impact.
CONFIG_XH2A_DRV=m
