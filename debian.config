# Y4 Debian kernel configuration overrides (kernel/debian.config).
# Consumed by scripts/build.py via scripts/kconfig/merge_config.sh
# together with the base fragment and the vendor cix.config; every
# CONFIG_ line here is also asserted post-olddefconfig.

# PCIe MPS policy: per-hierarchy optimum. SAFE walks each root-port
# tree and sets every device to the minimum DevCap.MaxPayload within
# that tree. On Y4 this yields 512 for the direct-RC trees (MAP1202
# system disk, r8127 10G NICs) and 256 for the switch tree under
# 0000:c0 (the M50 card and the Optane 16G drives cap at 256), which
# also lifts the card off its firmware-default 128 and removes the
# completion-size mismatch that surfaced as MalfTLP/CmpltTO when the
# root complex generated 512-byte completions towards a 128-byte-MPS
# endpoint. MRRS follows each device's configured MPS under SAFE
# (drivers/pci/probe.c pcie_write_mrrs, Y4-modified: the safe-mode
# write/read-back/halve loop applies instead of the historical blanket
# skip), so any device plugged into the M.2 slots lands at its tree's
# optimum without per-device quirks. PCIE_BUS_PERFORMANCE is
# deliberately NOT used: it sets each endpoint to its own DevCap
# without keeping the root port at the tree minimum, which re-opens
# the oversized-completion failure towards the card.
CONFIG_PCIE_BUS_SAFE=y
